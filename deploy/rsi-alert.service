[Unit]
Description=Cryptocurrency RSI Telegram Alert
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rsi-alert
ExecStart=/opt/rsi-alert/.venv/bin/python -m rsi_alert
Restart=always
RestartSec=10
EnvironmentFile=/opt/rsi-alert/.env
User=rsi-alert
Group=rsi-alert
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

