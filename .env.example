# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token
# One ID, or several comma-separated IDs.
TELEGRAM_CHAT_ID=123456789

# ALL scans every active contract/pair for the selected Toobit market.
# Or use a comma-separated list, for example: BTC,ETH,SOL
SYMBOLS=ALL
QUOTE_ASSET=USDT
EXCLUDE_SYMBOLS=

# One timeframe or several comma-separated timeframes.
CANDLE_INTERVAL=30m,1d
RSI_PERIOD=14
RSI_LOWER=30
RSI_UPPER=90
SCAN_EVERY_SECONDS=300
# 0 means do not repeat while RSI remains in the same extreme zone.
ALERT_COOLDOWN_MINUTES=0
MAX_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=15
MARKET_BASE_URL=https://api.toobit.com
# futures scans active crypto-only linear USDT-M perpetual contracts (no RWA/TradFi).
MARKET_TYPE=futures

# Optional: needed when the server reaches Toobit/Telegram through a proxy.
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
TELEGRAM_ADMIN_CHAT_IDS=123456789
STATE_FILE=/app/data/settings.json
